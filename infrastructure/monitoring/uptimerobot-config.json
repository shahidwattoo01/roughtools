{
  "monitors": [
    {
      "friendly_name": "RoughTools — Homepage",
      "url": "https://roughtools.com",
      "type": 1,
      "interval": 60,
      "http_method": "GET",
      "keyword_type": 2,
      "keyword_value": "RoughTools",
      "alert_contacts": "CONTACT_ID_HERE"
    },
    {
      "friendly_name": "RoughTools — API Health",
