# ─── Database ─────────────────────────────────────────────
# DB user/name: create a dedicated 'roughtools' role in production Postgres
DATABASE_URL=postgresql://roughtools:password@prod-db:5432/roughtools?connection_limit=15&pool_timeout=30&schema=public
DATABASE_URL_DIRECT=postgresql://roughtools:password@prod-db:5432/roughtools?schema=public

# ─── Redis ────────────────────────────────────────────────
REDIS_URL=redis://redis-prod:6379/0
REDIS_MAX_MEMORY=256mb
REDIS_MAX_MEMORY_POLICY=allkeys-lru
REDIS_APPENDONLY=yes

# ─── App ──────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=https://roughtools.com
SITE_URL=https://roughtools.com

# ─── Auth ─────────────────────────────────────────────────
JWT_SECRET=CHANGE-THIS-IN-PRODUCTION-USE-openssl-rand-base64-256-bit
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ─── Deployment ───────────────────────────────────────────
DEPLOY_TARGET=production
GITHUB_REPOSITORY=your-org/roughtools
API_REPLICAS=3
WEB_REPLICAS=3
API_PORT=4000
WEB_PORT=443
POSTGRES_USER=roughtools
POSTGRES_PASSWORD=CHANGE-THIS
POSTGRES_DB=roughtools
# S3 bucket for backups — bucket name: roughtools-backups
S3_BUCKET=roughtools-backups

# ─── Google Analytics 4 ───────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Google Search Console ────────────────────────────────
NEXT_PUBLIC_GSC_VERIFICATION_TOKEN=your-gsc-token-here

# ─── Google AdSense ───────────────────────────────────────
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXXXX

# ─── Microsoft Clarity ────────────────────────────────────
NEXT_PUBLIC_CLARITY_PROJECT_ID=XXXXXXXXXX

# ─── Sentry ───────────────────────────────────────────────
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_RELEASE=1.0.0

# ─── UptimeRobot ──────────────────────────────────────────
UPTIME_ROBOT_API_KEY=ur-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── Internal Analytics ───────────────────────────────────
IP_HASH_SECRET=CHANGE-THIS-TO-A-LONG-RANDOM-STRING-32CHARS-MIN
ADMIN_API_KEY=CHANGE-THIS-TO-A-VERY-LONG-RANDOM-STRING

# ─── Logging ──────────────────────────────────────────────
SERVICE_NAME=roughtools-api
LOG_DIR=/var/log/roughtools
