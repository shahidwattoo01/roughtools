# ─── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@staging-db:5432/roughtools_staging

# ─── Redis ───────────────────────────────────────────────
REDIS_URL=redis://staging-redis:6379

# ─── App ──────────────────────────────────────────────────
NODE_ENV=staging
PORT=4000
LOG_LEVEL=debug
CORS_ORIGIN=https://staging.roughtools.com
SITE_URL=https://staging.roughtools.com

# ─── Auth ──────────────────────────────────────────────────
JWT_SECRET=staging-jwt-secret-change-in-prod
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# ─── Deployment ─────────────────────────────────────────────
DEPLOY_TARGET=staging
