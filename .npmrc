# Flat node_modules (like npm/yarn) — no symlinks/junctions.
# This machine's pnpm virtual store was corrupting (packages extracted as
# empty folders), so the symlink-based layout is disabled entirely.
node-linker=hoisted

shamefully-hoist=false
public-hoist-pattern[]=*next*
public-hoist-pattern[]=*react*
public-hoist-pattern[]=*types*
public-hoist-pattern[]=typescript
public-hoist-pattern[]=eslint*
public-hoist-pattern[]=acorn
public-hoist-pattern[]=picocolors
public-hoist-pattern[]=tsup
fetch-timeout=600000
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-retries=5
