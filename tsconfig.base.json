{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@toolverse/storage": ["packages/storage/src/index.ts"],
      "@toolverse/storage/*": ["packages/storage/src/*"],
      "@toolverse/cache": ["packages/cache/src/index.ts"],
      "@toolverse/queue": ["packages/queue/src/index.ts"],
      "@platform/db": ["packages/db/src/index.ts"],
      "@platform/db/*": ["packages/db/src/*"],
      "@platform/iq-engine": ["packages/iq-engine/src/index.ts"],
      "@workspace/ui": ["packages/ui/src/index.ts"],
      "@workspace/ui/*": ["packages/ui/src/*"]
    }
  },
  "exclude": ["node_modules", "**/dist", "**/.next"]
}