# ============================================
# ENVIRONMENT CONFIGURATION
# ============================================
NODE_ENV=development

# SERVER
PORT=3000
SSL_PORT=3443

# JWT (Change these! Min 32 characters)
JWT_SECRET=your-super-secret-jwt-key-change-this-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-32
JWT_REFRESH_EXPIRES_IN=7d

# COOKIES (Change this! Min 32 characters)
COOKIE_SECRET=your-cookie-secret-change-this-32-characters

# CSRF
CSRF_TOKEN_LENGTH=32

# RATE LIMITING
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5

# SSL/TLS
ENFORCE_HTTPS=true

# CSP
CSP_ENABLED=true

# TRUSTED ORIGINS (comma separated)
TRUSTED_ORIGINS=http://localhost:3000,https://localhost:3443

# DDoS
MAX_REQUEST_SIZE=10mb
REQUEST_TIMEOUT_MS=30000