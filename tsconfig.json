{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@platform/ui": ["packages/ui/src/index.ts"],
      "@platform/utils": ["packages/utils/src/index.ts"],
      "@platform/config": ["packages/config/src/index.ts"],
      "@platform/engine": ["packages/engine/src/index.ts"],
      "@platform/validation": ["packages/validation/src/index.ts"],
      "@platform/calculators-core": ["packages/calculators-core/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", ".next"]
}