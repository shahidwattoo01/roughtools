# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/roughtools
DATABASE_URL_DIRECT=postgresql://user:password@localhost:5432/roughtools
POSTGRES_USER=roughtools
POSTGRES_PASSWORD=changeme
POSTGRES_DB=roughtools

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_MAX_MEMORY=128mb

# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-256-bit-secret
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
CSRF_SECRET=change-this-secret
NEXTAUTH_SECRET=change-this-secret
NEXTAUTH_URL=http://localhost:3000

# ─── Email (Resend — https://resend.com, free tier: 3000 emails/month) ──────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=hello@roughtools.com
SUPPORT_EMAIL=support@roughtools.com

# ─── Stripe Billing ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_TEAM=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_API=price_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Analytics & Monitoring ─────────────────────────────────────────────────────
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_RELEASE=1.0.0
# Get from: https://analytics.google.com → Admin → Data Streams → Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GSC_VERIFICATION_TOKEN=your-gsc-token-here
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXXXX
# Get from: https://clarity.microsoft.com → Settings → Overview → Project ID
NEXT_PUBLIC_CLARITY_PROJECT_ID=XXXXXXXXXX
UPTIME_ROBOT_API_KEY=ur-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── AdSense slot IDs (from AdSense dashboard) ───────────────────────────────────
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_MIDDLE=
NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=

# ─── Logging ───────────────────────────────────────────────────────────────────
LOGTAIL_SOURCE_TOKEN=

# ─── Storage ───────────────────────────────────────────────────────────────────
# S3 bucket for file uploads (create: roughtools-uploads in your AWS account)
S3_BUCKET=roughtools-uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ─── PDF Processing ─────────────────────────────────────────────────────────────
GOTENBERG_URL=http://localhost:3030
ILOVEPDF_API_KEY=

# ─── Internal ──────────────────────────────────────────────────────────────────
IP_HASH_SECRET=change-this-to-a-32-char-min-random-string
ADMIN_API_KEY=change-this-to-a-very-long-random-string

# ─── Admin Panel ───────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@roughtools.com
ADMIN_PASSWORD=         # store a bcrypt hash: node -e "require('bcryptjs').hash('yourpw',12).then(console.log)"
ADMIN_JWT_SECRET=change-this-to-a-random-256-bit-secret

# ─── AI / Claude API ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Site URL (used in sitemaps, SEO, canonical URLs) ─────────────────────────
NEXT_PUBLIC_SITE_URL=https://roughtools.com

# ─── Upstash Redis (for edge-compatible Redis; see packages/redis) ─────────────
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxxxxxxxxxxxxxxxxxxxxx
