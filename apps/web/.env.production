# ============================================================
# PRODUCTION ENVIRONMENT — fill every value before deploying
# ============================================================

# Site
NEXT_PUBLIC_SITE_URL=https://roughtools.com
NEXT_PUBLIC_APP_URL=https://roughtools.com
NEXT_PUBLIC_APP_NAME=RoughTools

# Database
DATABASE_URL=

# Authentication  (generate: openssl rand -hex 32)
NEXTAUTH_URL=https://roughtools.com
NEXTAUTH_SECRET=

# OAuth — Google  (console.cloud.google.com → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth — Facebook  (developers.facebook.com → My Apps → Settings → Basic)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# OAuth — X / Twitter  (developer.twitter.com → Projects → App → Keys and Tokens → OAuth 2.0)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# OAuth — LinkedIn  (linkedin.com/developers → My Apps → Auth)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Admin panel  (change from the dev default!)
ADMIN_EMAIL=shahidwattoo0111@gmail.com
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=

# Google Analytics 4
# AdSense → Analytics → Measurement ID  (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google AdSense
# AdSense → Sites → Get code → data-ad-client value  (ca-pub-XXXXXXXXXXXXXXXX)
NEXT_PUBLIC_ADSENSE_CLIENT=
# AdSense → Ads → By ad unit → slot numbers
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_MIDDLE=
NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=

# Anthropic AI  (generate: https://console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=

# IQ Test session signing  (generate: openssl rand -hex 32)
IQ_SESSION_SECRET=

# Contact form email  (generate: https://resend.com → API Keys)
RESEND_API_KEY=
# Verified sender address — after verifying roughtools.com in Resend dashboard
# Leave blank to use Resend's shared domain (works but shows resend.dev as sender)
RESEND_FROM_EMAIL=

# Redis (optional — leave blank to disable)
REDIS_URL=
REDIS_ENABLED=false

# Gotenberg PDF service (optional — for IQ report PDF generation)
# Run locally: docker run -p 3001:3000 gotenberg/gotenberg:8
GOTENBERG_URL=
