{
  "name": "@workspace/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "prisma generate --schema=../../packages/db/prisma/schema.prisma",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest --testPathPattern='__tests__/unit'",
    "test:integration": "jest --testPathPattern='__tests__/integration' --testTimeout=15000",
    "test:e2e": "playwright test",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --forceExit",
    "clean": "rm -rf .next .turbo node_modules",
    "submit-indexnow": "tsx scripts/submit-indexnow.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@platform/db": "workspace:*",
    "@platform/iq-engine": "workspace:*",
    "@prisma/client": "^5.22.0",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.26",
    "@toolverse/queue": "workspace:*",
    "@toolverse/storage": "workspace:*",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@workspace/ui": "workspace:*",
    "bcryptjs": "^2.4.3",
    "canvas": "^3.2.3",
    "clsx": "^2.1.0",
    "docx": "^9.6.1",
    "fabric": "^7.4.0",
    "gray-matter": "^4.0.3",
    "html2canvas": "^1.4.1",
    "ioredis": "^5.4.2",
    "jose": "^5.2.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "mammoth": "^1.12.0",
    "next": "^14.1.0",
    "next-auth": "^4.24.0",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "unpdf": "^1.6.2",
    "pdfjs-dist": "3.11.174",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.8.1",
    "resend": "^3.2.0",
    "stripe": "^22.2.0",
    "tailwind-merge": "^2.2.0",
    "web-vitals": "^5.2.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.43.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.2.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.1.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "ts-jest": "^29.1.0",
